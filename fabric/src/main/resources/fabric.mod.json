{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/myluckyblock",
        "sources": "https://github.com/SirinUnofficial/MyLuckyBlock",
        "issues": "https://github.com/SirinUnofficial/MyLuckyBlock/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.sycamore0.myluckyblock.MyLuckyBlock"
        ],
        "client": [
            "io.github.sycamore0.myluckyblock.client.MyLuckyBlockClient"
        ],
        "modmenu": [
            "io.github.sycamore0.myluckyblock.client.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=1.21 <1.21.2",
        "java": ">=${java_version}"
    },
    "suggests": {
        "cloth-config": "*"
    }
}
